{
  "name": "digitalkid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "audio:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-continent-audio.ps1 -Language ro",
    "audio:generate:en": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-continent-audio.ps1 -Language en",
    "audio:generate:es": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-continent-audio.ps1 -Language es",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "i18n-iso-countries": "^7.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
